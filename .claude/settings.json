{
  "permissions": {
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew bootRun:*)",
      "Read(./docs/spec/**)"
    ],
    "deny": [
      "Edit(./docs/spec/**)",
