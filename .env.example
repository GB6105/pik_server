# Copy to .env.local for local development. Never commit real values.

# Local PostgreSQL container (compose.yaml)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Deployed server (ECS task secrets from AWS SSM Parameter Store; DB password from RDS-managed Secrets Manager, ADR-0015)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
