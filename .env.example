# Copy to .env.local for local development. Never commit real values.

# Local PostgreSQL container (compose.yaml)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Deployed server (ECS task secrets from AWS SSM Parameter Store; DB password from RDS-managed Secrets Manager, ADR-0015)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Access token signing keys: JWK set JSON with one private ES256 key and any previous public keys (ADR-0027).
# Leave empty locally to sign with an ephemeral key; required outside the local and test profiles.
PIK_SECURITY_JWT_JWK_SET=

# HMAC keys for Android device IDs (trial reinstall detection): "<version>:<base64 key>" entries separated by commas,
# 32 bytes or more each; the highest version is current (ADR-0029). Leave empty locally to use an ephemeral key;
# required outside the local and test profiles.
PIK_USAGE_DEVICE_KEYS=
